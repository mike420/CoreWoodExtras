      <ImageFiles Include="$(AssetsDir)\Images\image-1_v.jpg" Condition="Exists('$(AssetsDir)\Images\image-1_v.jpg')" />
      <ImageFiles Include="$(AssetsDir)\Images\image-2_h.jpg" Condition="Exists('$(AssetsDir)\Images\image-2_h.jpg')" />
      <ImageFiles Include="$(AssetsDir)\Images\image-2_s.jpg" Condition="Exists('$(AssetsDir)\Images\image-2_s.jpg')" />
      <ImageFiles Include="$(AssetsDir)\Images\image-2_v.jpg" Condition="Exists('$(AssetsDir)\Images\image-2_v.jpg')" />
      <ImageFiles Include="$(AssetsDir)\Images\image-3_h.jpg" Condition="Exists('$(AssetsDir)\Images\image-3_h.jpg')" />
      <ImageFiles Include="$(AssetsDir)\Images\image-3_s.jpg" Condition="Exists('$(AssetsDir)\Images\image-3_s.jpg')" />
      <ImageFiles Include="$(AssetsDir)\Images\image-3_v.jpg" Condition="Exists('$(AssetsDir)\Images\image-3_v.jpg')" />
      <LanguageFiles Include="$(AssetsDir)\Translations\English\CoreWoodExtras.json" Condition="Exists('$(AssetsDir)\Translations\English\CoreWoodExtras.json')" />
    </ItemGroup>
